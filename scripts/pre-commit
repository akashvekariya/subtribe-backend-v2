#!/bin/bash
#
# Git pre-commit hook
# Runs linting and tests before allowing commit
# Prevents broken code from reaching GitHub Actions
#

set -e

echo "🔍 Running pre-commit checks..."
echo ""

# Activate virtual environment
if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
else
    echo "❌ Virtual environment not found. Run: python -m venv .venv && pip install -r requirements.txt"
    exit 1
fi

# 1. Ruff linting (errors only)
echo "📝 Step 1/3: Running Ruff linter..."
if ruff check . --select E,F,W --quiet; then
    echo "   ✅ Linting passed"
else
    echo ""
    echo "❌ Linting failed! Fix errors before committing."
    echo "   Run: ruff check . --select E,F,W"
    echo "   Auto-fix: ruff check . --fix"
    exit 1
fi
echo ""

# 2. Code formatting check
echo "🎨 Step 2/3: Checking code formatting..."
if ruff format --check . --quiet; then
    echo "   ✅ Formatting check passed"
else
    echo ""
    echo "❌ Code formatting issues found!"
    echo "   Run: ruff format ."
    exit 1
fi
echo ""

# 3. Run unit tests (same as GitHub Actions)
echo "🧪 Step 3/3: Running unit tests..."

# Set test environment variables (same as CI)
export DATABASE_URL="postgresql+asyncpg://test:test@localhost:5432/test"
export JWT_SECRET_KEY="test-secret-key-for-ci"
export JWT_ALGORITHM="HS256"
export JWT_EXPIRY_DAYS="15"
export SUPABASE_URL="https://test.supabase.co"
export SUPABASE_ANON_KEY="test-anon-key"
export SUPABASE_SERVICE_KEY="test-service-key"
export SUPABASE_JWT_SECRET="test-jwt-secret"
export GCS_BUCKET_NAME="test-bucket"
export GCS_PROJECT_ID="test-project"
export GOOGLE_APPLICATION_CREDENTIALS="/tmp/fake-credentials.json"
export CORS_ORIGINS='["http://localhost:3000"]'
export ENVIRONMENT="testing"

# Create fake credentials file
mkdir -p /tmp
echo '{"type": "service_account"}' > /tmp/fake-credentials.json

# Run tests
if pytest tests/unit/test_schemas.py tests/unit/test_services.py -q --tb=line; then
    echo "   ✅ All tests passed"
else
    echo ""
    echo "❌ Tests failed! Fix tests before committing."
    echo "   Run: pytest tests/unit/ -v"
    exit 1
fi

echo ""
echo "✅ All pre-commit checks passed!"
echo "💾 Proceeding with commit..."
echo ""

exit 0

