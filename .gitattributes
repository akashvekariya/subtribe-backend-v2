# Force LF line endings for all text files
* text eol=lf

# Python files
*.py text eol=lf

# Config files
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.env text eol=lf

# Docker files
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
*.sh text eol=lf

# Requirements
requirements*.txt text eol=lf
pyproject.toml text eol=lf

# Documentation
*.md text eol=lf
LICENSE text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
*.gz binary
