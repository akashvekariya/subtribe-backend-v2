# App Configuration
ENVIRONMENT=
DEBUG=
LOG_LEVEL=

# Database (from Supabase → Settings → Database → Connection String)
DATABASE_URL= # with +asyncpg
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_ECHO=

# Supabase (from Supabase dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ACCESS_TOKEN_EXPIRY=
SUPABASE_REFRESH_TOKEN_EXPIRY=

# Backend JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_EXPIRY_DAYS=
REFRESH_TOKEN_EXPIRY_DAYS=

# Google Cloud Storage
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# CORS (frontend URLs)
CORS_ORIGINS=

# Pagination
DEFAULT_PAGE_SIZE=
MAX_PAGE_SIZE=

# File Upload
MAX_RESUME_SIZE_MB=
ALLOWED_RESUME_TYPES=

# Invitation
INVITATION_EXPIRY_HOURS=
