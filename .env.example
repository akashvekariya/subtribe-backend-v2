# App Configuration
ENVIRONMENT=
DEBUG=
LOG_LEVEL=

# Database (from Supabase → Settings → Database → Connection String)
DATABASE_URL= # with +asyncpg
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_ECHO=

# Supabase (from Supabase dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ACCESS_TOKEN_EXPIRY=
SUPABASE_REFRESH_TOKEN_EXPIRY=

# Backend JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_EXPIRY_DAYS=
REFRESH_TOKEN_EXPIRY_DAYS=

# Cookie Configuration (HTTP-only cookie authentication)
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_DOMAIN=
COOKIE_MAX_AGE=

# Google Cloud Storage
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# CORS (frontend URLs)
CORS_ALLOWED_ORIGINS=

# Pagination
DEFAULT_PAGE_SIZE=
MAX_PAGE_SIZE=

# File Upload
MAX_RESUME_SIZE_MB=
ALLOWED_RESUME_TYPES=

# Invitation
INVITATION_EXPIRY_HOURS=

# Logging Configuration
LOG_MODE=
THIRD_PARTY_LOG_LEVEL=
LOG_FORMAT=
LOG_SAMPLING_RATE=
LOG_REQUEST_BODY=
LOG_RESPONSE_BODY=

# Email Service Configuration
EMAIL_ENABLED=
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_SEND_TIME_IST=

# SendGrid Configuration
SENDGRID_API_KEY=
SENDGRID_SANDBOX_MODE=

# Google Cloud Tasks (for production scheduled email sending)
GCP_CLOUD_TASKS_QUEUE=
GCP_CLOUD_TASKS_LOCATION=

# AI Keys
AI_RESUME_EVAL_SERVICE_URL=
GOOGLE_API_KEY=
SUPER_ADMIN_EMAILS=
BAML_LOG=

# Service URLs
# BACKEND_URL: leave empty to auto-detect on Cloud Run
BACKEND_URL=
DASHBOARD_URL=http://localhost:3000

# subtribe-ai package settings
SUBTRIBE_AI_GOOGLE_API_KEY=
SUBTRIBE_AI_OPENAI_API_KEY=
SUBTRIBE_AI_DEFAULT_MODEL=gemini-2.0-flash
SUBTRIBE_AI_LANGFUSE_ENABLED=false
SUBTRIBE_AI_LANGFUSE_PUBLIC_KEY=
SUBTRIBE_AI_LANGFUSE_SECRET_KEY=

# Bulk resume upload
BULK_UPLOAD_CONCURRENT_PER_BATCH=5
BULK_UPLOAD_GLOBAL_MAX_CONCURRENT=15
BULK_UPLOAD_TASK_QUEUE_NAME=bulk-upload-tasks
BULK_UPLOAD_TASK_STAGGER_SECONDS=2
